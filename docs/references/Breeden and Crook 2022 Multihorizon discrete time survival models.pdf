      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/postscript</dc:format>
         <dc:identifier>10.1080/01605682.2017.1390523</dc:identifier>
         <dc:lang>en</dc:lang>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A chi-square-based inconsistency index for pairwise comparison matrices</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Michele Fedrizzi</rdf:li>
               <rdf:li>Fabio Ferrari</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Analytic hierarchy process</rdf:li>
               <rdf:li>pairwise comparison matrices</rdf:li>
               <rdf:li>consistency indices</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Journal of the Operational Research Society, 2017. doi:10.1080/01605682.2017.1390523</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Taylor &amp; Francis</rdf:li>
            </rdf:Bag>
         </dc:publisher>
      </rdf:Description>
